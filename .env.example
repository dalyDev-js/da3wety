# Public site URL (used for metadataBase, QR payloads, share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Settings > API keys — new publishable/secret key system)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Postgres (Connect > Connection string)
# Runtime: transaction pooler, port 6543 (prepared statements disabled in code)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# drizzle-kit: session pooler, port 5432
DATABASE_MIGRATION_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Vercel Cron bearer secret (also set in the Vercel project env)
CRON_SECRET=change-me-to-a-random-32-char-string

# Comma-separated emails that get is_admin on first login
ADMIN_EMAILS=you@example.com

# WhatsApp number shown in the "upgrade" call to action (E.164)
NEXT_PUBLIC_SUPPORT_WHATSAPP=+201000000000

# Dev-only email/password login route for local testing and Playwright (never enable in production)
DEV_LOGIN_ENABLED=false
